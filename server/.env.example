# 环境变量示例（真实值请通过命令行或部署时的 EnvironmentFile 传入，勿提交到仓库）
# 端口，后端仅监听 127.0.0.1
# PORT=3001
# SQLite 数据库文件路径（必须位于网站公开目录之外）
# DB_PATH=/srv/exam-prep/server/data/app.db
# 会话有效期（天）
# SESSION_TTL_DAYS=7
# 生产 HTTPS 环境设为 1，给 Cookie 加 Secure 属性；本地 HTTP 开发保持 0
# COOKIE_SECURE=0
# 反向代理后设 1（信任 X-Forwarded-For，供限流识别真实 IP）
# TRUST_PROXY=0
